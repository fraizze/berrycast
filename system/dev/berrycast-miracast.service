# Miracast (Windows + K) en « Miracast over Infrastructure » (MS-MICE) : annonce Wi-Fi Direct
# (sans groupe), connexion du PC par le Wi-Fi de la maison (port 7250), négociation RTSP,
# lecteur GStreamer.
#
# Droits : utilisateur « berrycast » (pas root), avec seulement :
# - groupe netdev : piloter wpa_supplicant par D-Bus (annonce Wi-Fi Direct) ;
# - groupes video, render, audio : afficher la vidéo (kmssink) et jouer le son.

[Unit]
Description=BerryCast : Miracast (Windows + K)
After=NetworkManager.service wpa_supplicant.service berrycast-devsetup.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=berrycast
Group=berrycast
SupplementaryGroups=netdev video render audio
WorkingDirectory=/opt/berrycast
Environment=PYTHONPATH=/opt/berrycast
Environment=PYTHONUNBUFFERED=1
# /run/berrycast : état partagé avec l'écran HDMI (gardé quand le service s'arrête)
RuntimeDirectory=berrycast
RuntimeDirectoryPreserve=yes
# Cache des polices de GStreamer (sinon « Fontconfig error: No writable cache directories »)
CacheDirectory=berrycast-miracast
Environment=XDG_CACHE_HOME=/var/cache/berrycast-miracast
ExecStart=/usr/bin/python3 -m berrycast.miracast.service
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
